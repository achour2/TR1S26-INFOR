# SMTP Gmail. Remplacez les valeurs avant de copier ce fichier vers .env.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre-adresse@gmail.com
EMAIL_HOST_PASSWORD=votre-nouveau-mot-de-passe-application-google
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL="TravelHub <votre-adresse@gmail.com>"
