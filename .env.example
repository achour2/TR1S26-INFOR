# Copiez ce fichier vers .env et remplissez les valeurs (ne commitez jamais .env).

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
DB_NAME=travelhub
DB_USER=traveluser
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# SMTP (facultatif : sans EMAIL_HOST, les codes s'affichent dans le terminal)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL="TravelHub <noreply@travelhub.local>"